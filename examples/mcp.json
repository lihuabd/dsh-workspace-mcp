{
  "mcpServers": {
    "demo-http": {
      "type": "http",
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${MCP_DEMO_TOKEN}"
      }
    },
    "demo-stdio": {
      "command": "node",
      "args": ["./tools/demo-mcp-server.js"],
      "env": {
        "DEMO_TOKEN": "${MCP_DEMO_TOKEN}"
      }
    }
  }
}
